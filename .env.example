# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
DB_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string-at-least-32-bytes
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=gmail-app-password
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production only (docker-compose.prod.yml)
DOMAIN=yourname.duckdns.org
# DDL_AUTO=update   # uncomment for the first boot on an empty database, then comment out again
